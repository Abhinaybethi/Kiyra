# ==============================================================================
# Kiyra - AI Interview Intelligence Platform - Configuration
# Local-First, Free-First Architecture
# ==============================================================================

# Application
APP_NAME="Kiyra — Interview Copilot"
DEBUG=false
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
DATABASE_URL="sqlite:///./data/interview_platform.db"
DB_ECHO=false

# ── AI Provider (BONSAI → local llama.cpp llama-server) ──────────────────────
# Primary provider. Supported: bonsai (default) | ollama (optional legacy).
# Both AI_PROVIDER and MODEL_PROVIDER are honored.
AI_PROVIDER=bonsai
# MODEL_PROVIDER=bonsai

# Model identifier recorded in agent runs / capabilities. llama.cpp serves the
# GGUF model loaded on the server command line; this value does NOT need to
# match a cloud model name.
MODEL_NAME=bonsai-8b
BONSAI_MODEL=bonsai-8b

# llama.cpp llama-server OpenAI-compatible endpoint
BONSAI_BASE_URL=http://127.0.0.1:8080/v1

# Dummy value required by the OpenAI-compatible wire protocol — NOT an OpenAI key.
BONSAI_API_KEY=local
BONSAI_TIMEOUT=120

# Local embeddings (sentence-transformers) used for the RAG pipeline
EMBEDDING_MODEL=all-MiniLM-L6-v2

# faster-whisper speech-to-text model: tiny | base | small | medium
TRANSCRIPTION_MODEL=base

# Optional legacy: Ollama (only used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Storage & Paths
UPLOAD_DIR="./uploads"
DATA_DIR="./data"
CHROMA_DIR="./data/chroma"
MAX_UPLOAD_BYTES=10485760

# Real-time WebSocket
WS_HEARTBEAT_INTERVAL=30

# ── GitHub-aware project retrieval (Phase 5.2) ──────────────────────────────
# Lets Kiyra answer questions about the candidate's ACTUAL repositories. Only
# project-related questions trigger retrieval; generic tech questions never
# touch GitHub. Tokens are read from the environment and never logged.

# Master switch for GitHub-backed project answers.
KIYRA_GITHUB_ENABLED=true

# Fine-grained token with read-only "Contents: read" access. Required for
# private repos; public repos work unauthenticated but rate-limited.
# GITHUB_TOKEN=ghp_xxx

# Single project (simplest setup).
# KIYRA_GITHUB_OWNER=my-github-username
# KIYRA_GITHUB_REPO=my-project-repo
# KIYRA_GITHUB_PROJECT_ID=my-project-repo
# KIYRA_GITHUB_PROJECT_NAME="Bus Booking System"
# KIYRA_GITHUB_DEFAULT_BRANCH=main

# Multiple projects: JSON array, overrides the single-project block above.
# KIYRA_GITHUB_PROJECTS_FILE=./data/github_projects.json
# [
#   {"project_id": "bus-booking", "project_name": "Bus Booking System",
#    "github_owner": "me", "github_repo": "bus-booking", "default_branch": "main"},
#   {"project_id": "shopsense", "project_name": "ShopSense",
#    "github_owner": "me", "github_repo": "shopsense", "default_branch": "main"}
# ]

# How many repo chunks are injected into the prompt (5-8 recommended).
KIYRA_GITHUB_TOP_K=6

# Hard ceiling (seconds) for GitHub work inside the live answer path.
KIYRA_GITHUB_REAL_TIMEOUT=3.0
# Repo tree/blob snapshot cache lifetime (seconds).
KIYRA_GITHUB_SNAPSHOT_TTL_S=600