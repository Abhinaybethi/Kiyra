# ==============================================================================
# AI Interview Intelligence Platform - Configuration
# Local-First, Free-First Architecture
# ==============================================================================

# Application
APP_NAME="AI Interview Platform"
DEBUG=false
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
DATABASE_URL="sqlite:///./data/interview_platform.db"
DB_ECHO=false

# AI Provider Configuration
# Supported: ollama, openai, openai_compatible, openrouter, lmstudio
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
TRANSCRIPTION_MODEL=base

# Ollama local endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Optional: External OpenAI-compatible provider (only used if MODEL_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Storage & Paths
UPLOAD_DIR="./uploads"
DATA_DIR="./data"
CHROMA_DIR="./data/chroma"
MAX_UPLOAD_BYTES=10485760

# Real-time WebSocket
WS_HEARTBEAT_INTERVAL=30
