# ==============================================================================
# Kiyra - AI Interview Intelligence Platform - Configuration
# Local-First, Free-First Architecture
# ==============================================================================

# Application
APP_NAME="Kiyra — Interview Copilot"
DEBUG=false
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
DATABASE_URL="sqlite:///./data/interview_platform.db"
DB_ECHO=false

# ── AI Provider (BONSAI → local llama.cpp llama-server) ──────────────────────
# Primary provider. Supported: bonsai (default) | ollama (optional legacy).
# Both AI_PROVIDER and MODEL_PROVIDER are honored.
AI_PROVIDER=bonsai
# MODEL_PROVIDER=bonsai

# Model identifier recorded in agent runs / capabilities. llama.cpp serves the
# GGUF model loaded on the server command line; this value does NOT need to
# match a cloud model name.
MODEL_NAME=bonsai-8b
BONSAI_MODEL=bonsai-8b

# llama.cpp llama-server OpenAI-compatible endpoint
BONSAI_BASE_URL=http://127.0.0.1:8080/v1

# Dummy value required by the OpenAI-compatible wire protocol — NOT an OpenAI key.
BONSAI_API_KEY=local
BONSAI_TIMEOUT=120

# Local embeddings (sentence-transformers) used for the RAG pipeline
EMBEDDING_MODEL=all-MiniLM-L6-v2

# faster-whisper speech-to-text model: tiny | base | small | medium
TRANSCRIPTION_MODEL=base

# Optional legacy: Ollama (only used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Storage & Paths
UPLOAD_DIR="./uploads"
DATA_DIR="./data"
CHROMA_DIR="./data/chroma"
MAX_UPLOAD_BYTES=10485760

# Real-time WebSocket
WS_HEARTBEAT_INTERVAL=30